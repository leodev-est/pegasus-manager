VITE_API_URL=http://localhost:3000

# Branding — usados no header/sidebar/telas públicas e no manifest do PWA.
# Se vazios, cai no fallback "Pegasus Manager" / "Pegasus" / #0B2E59.
VITE_ORG_NAME=
VITE_ORG_SHORT_NAME=
VITE_ORG_LOGO_URL=
VITE_THEME_PRIMARY_COLOR=

# Ativa a sugestão automática de gênero (genderize.io) no cadastro de atletas.
# Chamada é feita direto do navegador; desative se o cliente não quiser
# depender desse serviço externo.
VITE_FEATURE_GENDERIZE_API=true
